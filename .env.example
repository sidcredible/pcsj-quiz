# Google service account (Drive read-only + Sheets read/write).
# Paste the whole key JSON on one line, or point at a file path with
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE instead. Never commit the real values.
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./.secrets/service-account.json

# Drive folder holding the quiz JSON files ("PCSJ Quizzes").
DRIVE_FOLDER_ID=1-qdGVaZd1hRQlrDTZEslGqpYVkayBVN9

# The one Google Sheet that logs everything ("PCSJ Quiz Log").
SHEET_ID=

# Minutes between automatic Drive re-scans.
QUIZ_REFRESH_MINUTES=10

# Default negative marking per wrong MCQ, as a fraction of the question's
# marks. 0 disables it. Overridable per attempt from the start screen.
DEFAULT_NEGATIVE_MARKING=0
