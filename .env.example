# Google service account (Drive read-only + Sheets read/write).
# Three ways to supply it; the app uses the first one that actually works, so a
# half-pasted value in one does not block a good value in another.
#
# 1. The key JSON itself. Simple, but it is ~2,300 characters of quotes,
#    braces and backslash-n, which dashboard forms truncate and mangle.
GOOGLE_SERVICE_ACCOUNT_KEY=
#
# 2. That same JSON, base64-encoded. No quotes, newlines or backslashes, so it
#    survives any form unchanged. Generate it with:
#      base64 -w0 service-account.json      # Linux
#      base64 -i service-account.json       # macOS
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
#
# 3. A path to the key file. Local development only; there is no file on Vercel.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./.secrets/service-account.json

# Drive folder holding the quiz JSON files ("PCSJ Quizzes").
DRIVE_FOLDER_ID=1-qdGVaZd1hRQlrDTZEslGqpYVkayBVN9

# The one Google Sheet that logs everything ("PCSJ Quiz Log").
SHEET_ID=

# Minutes between automatic Drive re-scans.
QUIZ_REFRESH_MINUTES=10

# Default negative marking per wrong MCQ, as a fraction of the question's
# marks. 0 disables it. Overridable per attempt from the start screen.
DEFAULT_NEGATIVE_MARKING=0

# --- Local mode: run with no Google credentials at all ---
# Point at a directory of quiz JSON files instead of Drive, and log attempts to
# a local file instead of the Sheet. Useful before the service account exists.
#   npx tsx scripts/write-sample-fixture.ts
#   QUIZ_FIXTURE_DIR=./fixtures SHEETS_DRY_RUN=1 npm run dev
# QUIZ_FIXTURE_DIR=./fixtures
# SHEETS_DRY_RUN=1
# SHEETS_DRY_RUN_FILE=./.dry-run/log.json
